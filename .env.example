# Copy to .env for local dev. Real secrets live in the macOS Keychain and are
# injected by `secrun`, not committed here. .env is gitignored.

# Local pgvector from docker-compose (host port 5436).
# DATABASE_URL is the owner role: migrations, DDL, preflight.
# APP_DATABASE_URL is the least-privilege app role the runtime uses, so row-level
# security applies to it (a superuser/owner would bypass RLS). The kd_app role is
# created by migration 0007.
DATABASE_URL=postgresql://kd:kd@localhost:5436/knowledge_desk
APP_DATABASE_URL=postgresql://kd_app:kd_app@localhost:5436/knowledge_desk

# Provider keys are unset by default, so the app runs in the loud mock fallback.
# Set these (via secrun in real runs) to switch to the real provider.
# ANTHROPIC_API_KEY=
# VOYAGE_API_KEY=

# Set to 1 to refuse startup instead of falling back to the mock provider.
PROVIDER_STRICT=0
